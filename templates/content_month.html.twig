{% block content_month %}
<div class="overlay_body"></div>

<div class="data_month">
    <div class="date"></div>
    <div class="show_major_minor">
        <a class="show_minor" href="">show minor versions</a>
        <a class="show_major" href="">show major versions</a>
    </div>
    <div class="close">X</div>
    <div class="month">
        <div class="version version_major">
            <div class="name"></div>
            <div class="percent_visual"></div>
            <div class="percent_number"></div>
        </div>
        <div class="version version_minor">
            <div class="name"></div>
            <div class="percent_visual"></div>
            <div class="percent_number"></div>
        </div>
    </div>
</div>
{% endblock %}