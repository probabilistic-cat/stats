{% extends "layout.html.twig" %}
{% use "content_month.html.twig" %}

{% block content %}
<div class="content">
    <div class="category">
        <a href="{{ categoryLink }}">{{ category }}</a>
    </div>

    <div class="subcategories">
    {% for subcategory, link in subcategories %}
        <a
            {% if subcategory == subcategoryCurrent %}class="selected"{% endif %}
            href="{{ link }}"
        >
            {{ subcategory }}
        </a>
    {% endfor %}
    </div>

{% if hasMinor %}
    <div class="show_minor">
        <a class="show" href="">show minor versions</a>
        <a class="hide" href="">hide minor versions</a>
    </div>
{% endif %}

    <div class="data">
    {% for monthData in data.monthDatas %}
        <div class="month" data-year="{{ monthData.date|date('Y') }}" data-month_name="{{ monthData.date|date('M') }}">
            <div class="date">{{ monthData.date|date('Y M') }}</div>
            <div class="versions">
            {% for version in monthData.versions %}
                <div
                    class="version {{ version.prefix|trim|lower }}_{{ version.name|lower|replace({' ': '_'}) }}"
                    data-name="{{ version.name }}"
                    data-percent="{{ version.percent }}"
                    title="{{ version.prefix }}{{ version.name }} - {{ version.percent }}%"
                    style="background-color: {{ version.color }}"
                >
                {% for minorVersion in version.minorVersions %}
                    <div
                        class="minor_version {{ version.prefix|trim|lower }}_{{ minorVersion.name }}"
                        data-name="{{ minorVersion.name }}"
                        data-percent="{{ minorVersion.percent }}"
                        title="{{ version.prefix }}{{ minorVersion.name }} - {{ minorVersion.percent }}%"
                        style="background-color: {{ minorVersion.color }}"
                    >
                        <p class="title minor_version_title"></p>
                    </div>
                {% endfor %}
                    <p class="title version_title"></p>
                </div>
            {% endfor %}
            </div>
        </div>
    {% endfor %}
    </div>
</div>

{{ block('content_month') }}
{% endblock %}
