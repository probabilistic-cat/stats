{% extends "layout.html.twig" %}

{% block styles %}
    {{ parent() }}
    <link href="{{ asset("styles/content.css") }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="{{ asset("js/content.js") }}"></script>
{% endblock %}

{% block content %}
    <p class="category">
        <a href="{{ categoryLink }}">{{ category }}</a>
    </p>

    <p class="subcategory">
    {% for subcategory, link in subcategories %}
        <a
            {% if subcategory == subcategoryCurrent %}class="selected"{% endif %}
            href="{{ link }}"
        >
            {{ subcategory }}
        </a>
    {% endfor %}
    </p>

{% if hasMinor %}
    <p class="show_minor">show minor versions</p>
{% endif %}

    <div class="data">
    {% for monthData in data.monthDatas %}
        <div class="month">
            <div class="date">{{ monthData.date }}</div>
            <div class="versions">
            {% for version in monthData.versions %}
                <div
                    class="version {{ version.prefix|trim|lower }}_{{ version.version|lower|replace({' ': '_'}) }}"
                    data-version="{{ version.version }}"
                    data-percent="{{ version.percent }}"
                    title="{{ version.prefix }}{{ version.version }} - {{ version.percent }}%"
                    style="background-color: {{ version.color }}"
                >
                {% for minorVersion in version.minorVersions %}
                    <div
                        class="minor_version {{ version.prefix|trim|lower }}_{{ minorVersion.version }}"
                        data-version="{{ minorVersion.version }}"
                        data-percent="{{ minorVersion.percent }}"
                        title="{{ version.prefix }}{{ minorVersion.version }} - {{ minorVersion.percent }}%"
                        style="background-color: {{ minorVersion.color }}"
                    >
                        <p class="title minor_version_title"></p>
                    </div>
                {% endfor %}
                    <p class="title version_title"></p>
                </div>
            {% endfor %}
            </div>
        </div>
    {% endfor %}
    </div>
{% endblock %}
