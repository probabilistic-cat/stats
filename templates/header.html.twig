{% block header %}
<div class="header">
    <div class="links">
        {% set categories = {
            'app_ios_version_all': 'iOS',
            'app_android_version_all': 'Android',
            'app_browser_all': 'Browser',
            'app_os_all': 'OS',
            'app_windows_desktop': 'Windows',
            'app_search_engine_all': 'Search',
            'app_platform_all': 'Platform',
            'app_ai_chatbot_all': 'AI chatbot',
            'app_vendor_all': 'Vendor',
        } %}

        {% for route, name in categories %}
            <a href="{{ path(route) }}" {% if route == categoryRoute %}class="selected"{% endif %} >{{ name }}</a>
        {% endfor %}
    </div>
</div>
{% endblock %}
