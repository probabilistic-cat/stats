{% extends "layout.html.twig" %}

{% block styles %}
    {{ parent() }}
    <link href="{{ asset("styles/content.css") }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="{{ asset("js/ios_versions.js") }}"></script>
{% endblock %}

{% block content %}
    <p class="subcategory">
        <a class="selected" href="">All</a>
        <a href="">iPhone</a>
        <a href="">iPad</a>
    </p>

    <div class="data">
    {% for date,monthData in data %}
        <div class="month">
            <div class="date">{{ date }}</div>
            <div class="versions">
            {% for version,percent in monthData %}
                <div class="version ios_{{ version }}" data-version="{{ version }}" data-percent="{{ percent }}" title="iOS {{ version }} - {{ percent }}%"></div>
            {% endfor %}
            </div>
        </div>
    {% endfor %}
    </div>
{% endblock %}
