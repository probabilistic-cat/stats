{% extends "layout.html.twig" %}

{% block styles %}
    {{ parent() }}
    <link href="{{ asset("styles/content.css") }}" type="text/css" rel="stylesheet" />
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="{{ asset("js/ios_versions.js") }}"></script>
{% endblock %}

{% block content %}
    <p class="subcategory">
        <a class="selected" href="">All</a>
        <a href="">iPhone</a>
        <a href="">iPad</a>
    </p>

    <div class="data">
    {% for monthData in data %}
        <div class="month">
            <div class="date">{{ monthData.date }}</div>
            <div class="versions">
            {% for version in monthData.versions %}
                <div class="version {{ version.prefix|trim|lower }}_{{ version.version|lower }}" data-version="{{ version.version }}" data-percent="{{ version.percent }}" title="{{ version.prefix }}{{ version.version }} - {{ version.percent }}%"></div>
            {% endfor %}
            </div>
        </div>
    {% endfor %}
    </div>
{% endblock %}
